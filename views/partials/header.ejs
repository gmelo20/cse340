<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    >

    <title><%= title %> | Community Service</title>

    <link
      rel="stylesheet"
      href="/css/style.css"
    >

</head>

<body>

<header>

    <div class="container header-container">

        <div class="logo">
            <h1>🌱 Community Service</h1>
        </div>

        <nav>

            <ul class="nav-links">

                <li>
                    <a href="/">Home</a>
                </li>

                <li>
                    <a href="/organizations">Organizations</a>
                </li>

                <li>
                    <a href="/categories">Categories</a>
                </li>

                <li>
                    <a href="/projects">Projects</a>
                </li>

                <% if (locals.user || (typeof session !== 'undefined' && session && session.user)) { %>

                  <li>
                    <a href="/account">Dashboard</a>
                  </li>

                  <li>
                    <a href="/account/logout">Logout</a>
                  </li>

                <% } else { %>

                  <li>
                    <a href="/account/login">Login</a>
                  </li>

                  <li>
                    <a href="/account/register">Register</a>
                  </li>

                <% } %>

            </ul>

        </nav>

    </div>

</header>

<main>

<div class="container">

<h2><%= title %></h2>
