<%- include('partials/header') %>

<div class="category-details">

    <h1>
        <%= category.category_name %>
    </h1>

    <h2>Projects</h2>

    <ul>

    <% projects.forEach(project => { %>

        <li>

            <a href="/project/<%= project.project_id %>">

                <%= project.project_name %>

            </a>

        </li>

    <% }) %>

    </ul>

</div>

<%- include('partials/footer') %>