<%- include('partials/header') %>

<p>Welcome, <%= user.user_firstname %>!</p>

<ul>

  <li><a href="/categories">Manage Categories</a></li>

  <li><a href="/organizations">Manage Organizations</a></li>

  <li><a href="/projects">Manage Projects</a></li>

  <% if (user.user_role === 'admin') { %>

    <li><a href="/account/users">Manage Users</a></li>

  <% } %>

</ul>

<h2>My Volunteered Projects</h2>

<% if (volunteeredProjects.length === 0) { %>

  <p>You have not volunteered for any projects yet.</p>

<% } else { %>

  <ul>

    <% volunteeredProjects.forEach(project => { %>

      <li>

        <a href="/projects/<%= project.project_id %>">
          <%= project.project_name %>
        </a>

        <form
          action="/volunteer/remove/<%= project.project_id %>?from=dashboard"
          method="POST"
          style="display:inline"
        >
          <button type="submit">Remove</button>
        </form>

      </li>

    <% }) %>

  </ul>

<% } %>

<%- include('partials/footer') %>
