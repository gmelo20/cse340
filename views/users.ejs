<%- include('partials/header') %>

<table>

  <thead>
    <tr>
      <th>First Name</th>
      <th>Last Name</th>
      <th>Email</th>
      <th>Role</th>
    </tr>
  </thead>

  <tbody>

    <% users.forEach(function(user) { %>

      <tr>
        <td><%= user.user_firstname %></td>
        <td><%= user.user_lastname %></td>
        <td><%= user.user_email %></td>
        <td><%= user.user_role %></td>
      </tr>

    <% }) %>

  </tbody>

</table>

<a href="/account">Back to Dashboard</a>

<%- include('partials/footer') %>
