<%- include('partials/header') %>

<div class="project-details">

    <h1>
        <%= project.project_name %>
    </h1>

    <h2>Categorias</h2>

    <ul>

    <% categories.forEach(category => { %>

        <li>

            <a href="/categories/<%= category.category_id %>">

                <%= category.category_name %>

            </a>

        </li>

    <% }) %>

    </ul>

</div>

<%- include('partials/footer') %>