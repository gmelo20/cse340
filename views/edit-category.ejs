<%- include('partials/header') %>

<form
  method="POST"
  action="/edit-category/<%= category.category_id %>"
>

<label>

Category Name

</label>

<input
  type="text"
  name="category_name"
  required
  maxlength="100"
  value="<%= category.category_name %>"
>

<button type="submit">

Update Category

</button>

</form>

<% if (errors.length > 0) { %>

<ul>

<% errors.forEach(error => { %>

<li><%= error %></li>

<% }) %>

</ul>

<% } %>

<%- include('partials/footer') %>